generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  OWNER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions Session[]
  cashEvents CashEvent[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  price       Float
  stock       Int
  unit        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cashEventItems CashEventItem[]
}

enum CashEventType {
  INCOME
  EXPENSE
}

enum CashEventCategory {
  LOCAL_SALE
  DELIVERY_ORDER
  DEBT_RETURN
  SALARY
  OTHER
}

model CashDay {
  id             String   @id @default(cuid())
  date           DateTime @unique
  openingBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events CashEvent[]
}

model CashEvent {
  id          String            @id @default(cuid())
  cashDayId   String
  userId      String
  type        CashEventType
  category    CashEventCategory
  amount      Float
  comment     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  cashDay CashDay @relation(fields: [cashDayId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  items   CashEventItem[]
}

model CashEventItem {
  id          String @id @default(cuid())
  eventId     String
  productId   String
  quantity    Int
  priceAtSale Float
  total       Float

  event   CashEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id])
}